---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." noindex>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Erreur 404</p>
      <h1>Oups, cette page s’est envolée.</h1>
      <p class="lead">Elle n’existe pas ou a été déplacée.</p>
      <div class="btn-row">
        <a class="btn" href="/">Retour à l’accueil</a>
        <a class="btn btn--ghost" href="/services">Services et prix</a>
      </div>
    </div>
  </section>
</Base>
