---
import Icon from '../Icon.astro';
import type { ProjectImage } from '../../lib/db/schema';
interface Props { projectId: string; images: ProjectImage[]; coverId: string | null }
const { projectId, images, coverId } = Astro.props;
const data = images.map(({ id, thumbUrl, url, caption, variant, visible, width, height }) => ({ id, thumbUrl, url, caption, variant, visible, width, height }));
---
<section class="panel" id="images" data-images data-project={projectId} data-cover={coverId ?? ''} data-initial={JSON.stringify(data)}>
  <div class="panel__head">
    <div>
      <h2>Images et maquettes</h2>
      <p>Glissez vos captures ici. Les images en hauteur sont classées « cellulaire » automatiquement. Glissez ⠿ pour réordonner.</p>
    </div>
    <span class="muted-s" data-img-status aria-live="polite"></span>
  </div>

  <label class="drop" data-drop>
    <Icon name="plus" />
    <strong>Ajouter des images</strong>
    <span class="muted-s">JPG, PNG, WebP ou AVIF · plusieurs fichiers à la fois · redimensionnées et optimisées automatiquement</span>
    <input type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif" multiple class="sr-only" data-file />
  </label>
  <div class="progress-line" hidden data-progress><span></span></div>

  <ul class="imgs" data-list></ul>
  <p class="muted-s" data-empty hidden>Aucune image pour l’instant. Ajoutez au moins une capture « ordinateur » pour l’image principale.</p>

  <template data-tpl>
    <li class="img-card">
      <button type="button" class="icon-btn img-card__drag" data-drag aria-label="Déplacer l’image (ou utilisez les flèches)">⠿</button>
      <div class="img-card__media"><img alt="" loading="lazy" /><div class="img-card__tags"></div></div>
      <input class="input" data-caption placeholder="Légende (ex. Page d’accueil)" maxlength="160" aria-label="Légende" />
      <div class="img-card__row">
        <select class="input" data-variant aria-label="Type de capture">
          <option value="desktop">Ordinateur</option>
          <option value="mobile">Cellulaire</option>
          <option value="autre">Autre</option>
        </select>
        <button type="button" class="icon-btn" data-left aria-label="Déplacer vers la gauche"><Icon name="arrow" class="rot180" /></button>
        <button type="button" class="icon-btn" data-right aria-label="Déplacer vers la droite"><Icon name="arrow" /></button>
      </div>
      <label class="check"><input type="checkbox" data-visible /> Visible sur la fiche projet</label>
      <div class="img-card__row">
        <button type="button" class="btn btn--ghost btn--xs" data-cover>Image principale</button>
        <label class="btn btn--ghost btn--xs">Remplacer<input type="file" accept="image/*" class="sr-only" data-replace /></label>
        <button type="button" class="icon-btn icon-btn--danger" data-delete aria-label="Supprimer l’image"><Icon name="close" /></button>
      </div>
    </li>
  </template>
</section>

<script>
  type Img = { id: string; thumbUrl: string; url: string; caption: string; variant: string; visible: boolean; width: number; height: number };
  const MAX_SIDE = 2400;
  const MAX_BYTES = 4_000_000;

  /** Réduit l’image dans le navigateur si nécessaire (limite d’envoi des serveurs : ~4,5 Mo). */
  async function prepare(file: File): Promise<{ blob: Blob; w: number; h: number }> {
    const bmp = await createImageBitmap(file).catch(() => null);
    if (!bmp) throw new Error(`« ${file.name} » n’est pas une image lisible.`);
    const { width: w, height: h } = bmp;
    if (file.size <= MAX_BYTES && Math.max(w, h) <= MAX_SIDE) { bmp.close(); return { blob: file, w, h }; }
    const scale = Math.min(1, MAX_SIDE / Math.max(w, h));
    const c = document.createElement('canvas');
    c.width = Math.round(w * scale); c.height = Math.round(h * scale);
    c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
    bmp.close();
    for (const q of [0.92, 0.85, 0.75]) {
      const blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/webp', q));
      if (blob && blob.size <= MAX_BYTES) return { blob, w: c.width, h: c.height };
    }
    throw new Error(`« ${file.name} » est trop lourde, même après compression.`);
  }

  const root = document.querySelector<HTMLElement>('[data-images]');
  if (root) {
    const pid = root.dataset.project!;
    let cover = root.dataset.cover || '';
    let items: Img[] = JSON.parse(root.dataset.initial || '[]');
    const list = root.querySelector<HTMLUListElement>('[data-list]')!;
    const tpl = root.querySelector<HTMLTemplateElement>('[data-tpl]')!;
    const status = root.querySelector<HTMLElement>('[data-img-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const prog = root.querySelector<HTMLElement>('[data-progress]')!;
    const say = (m: string) => { status.textContent = m; };

    const api = async (url: string, init: RequestInit) => {
      const r = await fetch(url, init);
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || 'Erreur du serveur.');
      return d;
    };
    const patch = (id: string, body: object) => api(`/api/admin/images/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

    function card(img: Img) {
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      li.dataset.id = img.id;
      const pic = li.querySelector('img')!;
      pic.src = img.thumbUrl; pic.alt = img.caption || 'Capture du projet';
      li.querySelector<HTMLInputElement>('[data-caption]')!.value = img.caption;
      li.querySelector<HTMLSelectElement>('[data-variant]')!.value = img.variant;
      li.querySelector<HTMLInputElement>('[data-visible]')!.checked = img.visible;
      return li;
    }
    function decorate() {
      list.querySelectorAll<HTMLLIElement>('li').forEach((li) => {
        const img = items.find((x) => x.id === li.dataset.id)!;
        const isCover = img.id === cover;
        li.classList.toggle('is-cover', isCover);
        li.classList.toggle('is-hidden-img', !img.visible);
        li.querySelector('.img-card__media')!.classList.toggle('is-mobile', img.variant === 'mobile');
        const tags = li.querySelector('.img-card__tags')!;
        tags.innerHTML = '';
        const add = (t: string, cls = '') => { const s = document.createElement('span'); s.textContent = t; if (cls) s.className = cls; tags.append(s); };
        if (isCover) add('★ Principale', 'is-cover-tag');
        if (img.variant === 'mobile') add('Cellulaire');
        if (!img.visible) add('Masquée');
        const btn = li.querySelector<HTMLButtonElement>('[data-cover]')!;
        btn.disabled = isCover;
        btn.textContent = isCover ? '★ Image principale' : 'Image principale';
      });
      empty.hidden = items.length > 0;
    }
    function render() {
      list.replaceChildren(...items.map(card));
      decorate();
    }
    async function saveOrder() {
      const ids = [...list.querySelectorAll<HTMLElement>('li')].map((li) => li.dataset.id!);
      items = ids.map((id) => items.find((x) => x.id === id)!);
      say('Enregistrement de l’ordre…');
      try { await api(`/api/admin/projects/${pid}/images-order`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ids }) }); say('✓ Ordre enregistré'); }
      catch (e) { say('Erreur : ' + (e as Error).message); }
    }

    async function upload(files: File[]) {
      prog.hidden = false;
      const bar = prog.querySelector('span')!;
      let done = 0;
      for (const f of files) {
        say(`Envoi de « ${f.name} »…`);
        try {
          const { blob, w, h } = await prepare(f);
          const fd = new FormData();
          fd.append('file', blob, f.name.replace(/\.\w+$/, '') + (blob === f ? f.name.match(/\.\w+$/)?.[0] ?? '' : '.webp'));
          fd.append('variant', h > w * 1.2 ? 'mobile' : 'desktop');
          const img = (await api(`/api/admin/projects/${pid}/images`, { method: 'POST', body: fd })) as Img & { cover: string };
          items.push(img);
          if (img.cover) cover = img.cover;
          list.append(card(img));
          decorate();
        } catch (e) {
          alert((e as Error).message);
        }
        done++;
        bar.style.width = `${(done / files.length) * 100}%`;
      }
      say(`✓ ${done} image${done > 1 ? 's' : ''} traitée${done > 1 ? 's' : ''}`);
      setTimeout(() => { prog.hidden = true; bar.style.width = '0'; }, 800);
    }

    // Ajout : sélection ou glisser-déposer de fichiers
    const input = root.querySelector<HTMLInputElement>('[data-file]')!;
    input.addEventListener('change', () => { if (input.files?.length) upload([...input.files]); input.value = ''; });
    const drop = root.querySelector<HTMLElement>('[data-drop]')!;
    drop.addEventListener('dragover', (e) => { if (e.dataTransfer?.types.includes('Files')) { e.preventDefault(); drop.classList.add('is-over'); } });
    drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
    drop.addEventListener('drop', (e) => {
      e.preventDefault(); drop.classList.remove('is-over');
      const files = [...(e.dataTransfer?.files ?? [])].filter((f) => f.type.startsWith('image/'));
      if (files.length) upload(files);
    });

    // Actions sur chaque carte
    list.addEventListener('change', async (e) => {
      const t = e.target as HTMLInputElement;
      const li = t.closest<HTMLLIElement>('li')!;
      const img = items.find((x) => x.id === li.dataset.id)!;
      try {
        if (t.matches('[data-caption]')) { await patch(img.id, { caption: t.value }); img.caption = t.value; say('✓ Légende enregistrée'); }
        if (t.matches('[data-variant]')) { await patch(img.id, { variant: t.value }); img.variant = t.value; say('✓ Type enregistré'); }
        if (t.matches('[data-visible]')) { await patch(img.id, { visible: t.checked }); img.visible = t.checked; say('✓ Visibilité enregistrée'); }
        if (t.matches('[data-replace]') && t.files?.[0]) {
          li.classList.add('is-busy');
          const { blob } = await prepare(t.files[0]);
          const fd = new FormData(); fd.append('file', blob, t.files[0].name);
          const fresh = (await api(`/api/admin/images/${img.id}`, { method: 'POST', body: fd })) as Img;
          Object.assign(img, fresh);
          li.querySelector('img')!.src = fresh.thumbUrl;
          li.classList.remove('is-busy');
          say('✓ Image remplacée');
        }
        decorate();
      } catch (err) { li.classList.remove('is-busy'); say('Erreur : ' + (err as Error).message); }
    });
    list.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      const li = b.closest<HTMLLIElement>('li')!;
      const id = li.dataset.id!;
      try {
        if (b.matches('[data-cover]')) {
          await api(`/api/admin/projects/${pid}/cover`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageId: id }) });
          cover = id; decorate(); say('✓ Image principale mise à jour');
        }
        if (b.matches('[data-delete]')) {
          if (!confirm('Supprimer définitivement cette image ?')) return;
          const r = (await api(`/api/admin/images/${id}`, { method: 'DELETE' })) as { cover: string | null };
          items = items.filter((x) => x.id !== id);
          cover = r.cover ?? '';
          li.remove(); decorate(); say('✓ Image supprimée');
        }
        if (b.matches('[data-left]') && li.previousElementSibling) { list.insertBefore(li, li.previousElementSibling); b.focus(); saveOrder(); }
        if (b.matches('[data-right]') && li.nextElementSibling) { list.insertBefore(li.nextElementSibling, li); b.focus(); saveOrder(); }
      } catch (err) { say('Erreur : ' + (err as Error).message); }
    });

    // Réorganisation par glisser-déposer (souris et doigt) via la poignée ⠿
    let drag: HTMLLIElement | null = null;
    list.addEventListener('pointerdown', (e) => {
      const h = (e.target as HTMLElement).closest('[data-drag]');
      if (!h) return;
      drag = h.closest('li');
      drag?.classList.add('is-dragging');
      (h as HTMLElement).setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    list.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const over = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLLIElement>('.img-card');
      if (!over || over === drag || over.parentElement !== list) return;
      const r = over.getBoundingClientRect();
      const after = e.clientX > r.left + r.width / 2 || e.clientY > r.bottom - 10;
      list.insertBefore(drag, after ? over.nextSibling : over);
    });
    const end = () => { if (!drag) return; drag.classList.remove('is-dragging'); drag = null; saveOrder(); };
    list.addEventListener('pointerup', end);
    list.addEventListener('pointercancel', end);

    render();
  }
</script>
