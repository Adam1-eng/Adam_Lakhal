---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  url?: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const { src, alt, url = '', class: cls = '', eager = false, sizes = '(min-width: 1000px) 560px, 92vw' } = Astro.props;
---
<figure class:list={['browser', cls]}>
  <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i><span class="browser__url">{url}</span></div>
  <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
</figure>
