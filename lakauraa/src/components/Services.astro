---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { capabilities } from '../data/site';
import type { Service } from '../lib/db/schema';
interface Props { services: Service[]; showAllLink?: boolean }
const { services, showAllLink = true } = Astro.props;
const icons: Record<string, string> = { vitrine: 'page', pro: 'pages', boutique: 'shop', entretien: 'care' };
---
<section class="section section--alt" id="solutions" aria-label="Services">
  <div class="wrap">
    <SectionHead eyebrow="La solution" title="Ce que je construis pour votre commerce." aura="pour votre commerce." align="split"
      lead="De la simple page qui inspire confiance à la boutique en ligne complète. Un seul développeur, du premier appel à la mise en ligne." />

    <div class="sv__grid">
      {services.map((s, i) => (
        <a href={`/services#${s.id}`} class="card spot sv reveal" style={`--i:${i}`}>
          <div class="sv__head">
            <span class="icon-badge"><Icon name={icons[s.id] ?? 'spark'} /></span>
            <span class="sv__num">0{i + 1}</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <ul class="sv__points">{s.points.map((pt) => <li>{pt}</li>)}</ul>
          <div class="sv__foot">
            <span class="chip chip--accent">{s.price}</span>
            <span class="sv__go">Découvrir <span class="sv__arrow"><Icon name="arrow-up-right" /></span></span>
          </div>
        </a>
      ))}
    </div>

    <div class="sv__caps reveal">
      <p class="sv__caps-title">Inclus selon votre forfait</p>
      <ul>
        {capabilities.map((c) => <li><Icon name="check" />{c}</li>)}
      </ul>
    </div>

    {showAllLink && (
      <div class="sv__more reveal">
        <a href="/services" class="btn btn--ghost">Voir les services et les prix <Icon name="arrow" class="arrow" /></a>
      </div>
    )}
  </div>
</section>

<style>
  .sv__grid { display: grid; gap: 1.2rem; }
  @media (min-width: 760px) { .sv__grid { grid-template-columns: repeat(2, 1fr); } }
  .sv { padding: 1.8rem; display: grid; gap: 0.8rem; align-content: start; }
  .sv__head { display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.6rem; }
  .sv__num { font-size: 0.78rem; color: var(--dim); }
  .sv h3 { font-size: clamp(1.35rem, 2.2vw, 1.6rem); }
  .sv > p { color: var(--muted); max-width: 48ch; }
  .sv__points { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.3rem; }
  .sv__points li { font-size: 0.8rem; color: var(--muted); padding: 0.25rem 0.6rem; border-radius: 8px; background: rgb(255 255 255 / 0.04); }
  .sv__foot { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  .sv__go { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; font-weight: 600; color: var(--muted); transition: color 0.3s; }
  .sv__arrow { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line-2); transition: background 0.35s, border-color 0.35s, transform 0.5s var(--ease); }
  .sv__arrow :global(svg) { width: 15px; height: 15px; }
  .sv:hover .sv__go { color: var(--text); }
  .sv:hover .sv__arrow { background: var(--aura-btn); border-color: transparent; transform: rotate(45deg); }

  .sv__caps { margin-top: 2.5rem; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.4rem 1.6rem; background: rgb(255 255 255 / 0.02); }
  .sv__caps-title { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); margin-bottom: 1rem; }
  .sv__caps ul { list-style: none; padding: 0; display: grid; gap: 0.8rem 1.2rem; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
  .sv__caps li { display: flex; align-items: center; gap: 0.55rem; font-size: 0.94rem; }
  .sv__caps :global(svg) { width: 16px; height: 16px; color: var(--accent); flex: none; }
  .sv__more { display: flex; justify-content: center; margin-top: 2.5rem; }
</style>
