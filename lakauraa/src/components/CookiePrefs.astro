---
// Gestion du consentement.
// Aujourd'hui, le site n'utilise que des éléments strictement nécessaires (aucune publicité, aucun pistage) :
// la bannière n'est donc PAS affichée. Si un outil optionnel est ajouté (ex. mesure d'audience),
// passer OPTIONAL_TOOLS à true : la bannière s'affichera et le choix sera disponible dans window.lkConsent.
import Icon from './Icon.astro';
const OPTIONAL_TOOLS = false;
---
<div data-consent data-optional={String(OPTIONAL_TOOLS)}>
  {OPTIONAL_TOOLS && (
    <div class="ck-banner" data-ck-banner hidden role="region" aria-label="Cookies">
      <p>J’utilise un outil de mesure d’audience pour améliorer le site. Vous pouvez l’accepter ou le refuser. <a href="/politique-cookies">En savoir plus</a></p>
      <div class="ck-banner__actions">
        <button type="button" class="btn btn--ghost btn--sm" data-ck-choice="refuse">Refuser</button>
        <button type="button" class="btn btn--primary btn--sm" data-ck-choice="accept">Accepter</button>
      </div>
    </div>
  )}

  <dialog class="ck" id="cookie-prefs" aria-labelledby="ck-title">
    <form method="dialog" class="ck__panel">
      <header class="ck__head">
        <h2 id="ck-title">Préférences de confidentialité</h2>
        <button value="cancel" class="ck__close" aria-label="Fermer"><Icon name="close" /></button>
      </header>
      <div class="ck__row">
        <div>
          <h3>Strictement nécessaires</h3>
          <p>Mémorisation de votre choix de numéro WhatsApp et de ces préférences (stockage local), cookie de session de l’espace administrateur. Toujours actifs.</p>
        </div>
        <span class="ck__on">Toujours actifs</span>
      </div>
      <div class="ck__row">
        <div>
          <h3>Mesure d’audience</h3>
          <p>{OPTIONAL_TOOLS ? 'Statistiques de visite anonymisées pour améliorer le site.' : 'Aucun outil de mesure d’audience ni de publicité n’est utilisé sur ce site actuellement.'}</p>
        </div>
        <label class="ck__switch">
          <input type="checkbox" name="analytics" disabled={!OPTIONAL_TOOLS} data-ck-analytics />
          <span aria-hidden="true"></span>
          <span class="sr-only">Autoriser la mesure d’audience</span>
        </label>
      </div>
      <p class="ck__more">Détails dans la <a href="/politique-cookies">politique relative aux cookies</a> et la <a href="/confidentialite">politique de confidentialité</a>.</p>
      <div class="ck__actions">
        <button value="save" class="btn btn--primary btn--sm" data-ck-save>Enregistrer</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  type Consent = { analytics: boolean; date: string };
  const KEY = 'lk_consent';
  const read = (): Consent | null => { try { return JSON.parse(localStorage.getItem(KEY) ?? 'null'); } catch { return null; } };
  const write = (c: Consent) => {
    try { localStorage.setItem(KEY, JSON.stringify(c)); } catch {}
    (window as any).lkConsent = c;
    window.dispatchEvent(new CustomEvent('lk:consent', { detail: c }));
  };
  (window as any).lkConsent = read();

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-cookie-prefs]');
    if (!t) return;
    e.preventDefault();
    const d = document.getElementById('cookie-prefs') as HTMLDialogElement | null;
    const box = d?.querySelector<HTMLInputElement>('[data-ck-analytics]');
    if (box) box.checked = Boolean(read()?.analytics);
    d?.showModal();
  });

  function init() {
    const root = document.querySelector<HTMLElement>('[data-consent]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const optional = root.dataset.optional === 'true';
    const banner = root.querySelector<HTMLElement>('[data-ck-banner]');
    if (optional && banner && !read()) banner.hidden = false;
    root.querySelectorAll<HTMLButtonElement>('[data-ck-choice]').forEach((b) =>
      b.addEventListener('click', () => { write({ analytics: b.dataset.ckChoice === 'accept', date: new Date().toISOString() }); banner!.hidden = true; }),
    );
    root.querySelector('[data-ck-save]')?.addEventListener('click', () => {
      const box = root.querySelector<HTMLInputElement>('[data-ck-analytics]');
      write({ analytics: optional && Boolean(box?.checked), date: new Date().toISOString() });
      if (banner) banner.hidden = true;
    });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .ck { padding: 0; border: 0; background: transparent; width: min(520px, 100% - 2rem); margin: auto; color: var(--text); }
  .ck::backdrop { background: rgb(4 4 8 / 0.65); backdrop-filter: blur(6px); }
  .ck__panel { display: grid; gap: 1.1rem; padding: 1.6rem; border-radius: 22px; background: var(--surface); border: 1px solid var(--line-2); }
  .ck__head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .ck__head h2 { font-size: 1.25rem; letter-spacing: -0.02em; }
  .ck__close { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line-2); color: var(--muted); }
  .ck__close :global(svg) { width: 17px; height: 17px; }
  .ck__row { display: flex; gap: 1rem; justify-content: space-between; align-items: flex-start; padding: 1rem; border-radius: 14px; border: 1px solid var(--line); background: rgb(255 255 255 / 0.02); }
  .ck__row h3 { font-family: var(--font-sans); font-size: 0.95rem; letter-spacing: 0; }
  .ck__row p { font-size: 0.85rem; color: var(--muted); margin-top: 0.25rem; }
  .ck__on { flex: none; font-size: 0.75rem; font-weight: 600; color: var(--ok); }
  .ck__switch { position: relative; flex: none; width: 44px; height: 26px; }
  .ck__switch input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .ck__switch input:disabled { cursor: not-allowed; }
  .ck__switch span[aria-hidden] { position: absolute; inset: 0; border-radius: 999px; background: var(--surface-3); border: 1px solid var(--line-2); transition: background 0.3s; pointer-events: none; }
  .ck__switch span[aria-hidden]::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: var(--muted); transition: transform 0.3s var(--ease), background 0.3s; }
  .ck__switch input:checked + span { background: var(--accent-strong); }
  .ck__switch input:checked + span::after { transform: translateX(18px); background: #fff; }
  .ck__switch input:focus-visible + span { outline: 2px solid var(--accent-2); outline-offset: 2px; }
  .ck__switch input:disabled + span { opacity: 0.5; }
  .ck__more { font-size: 0.82rem; color: var(--dim); }
  .ck__more a { text-decoration: underline; color: var(--muted); }
  .ck__actions { display: flex; justify-content: flex-end; }
  .ck-banner { position: fixed; z-index: 85; left: 1rem; right: 1rem; bottom: 1rem; max-width: 560px; display: grid; gap: 0.9rem; padding: 1.1rem 1.2rem; border-radius: 18px; background: var(--surface); border: 1px solid var(--line-2); box-shadow: 0 30px 60px -30px #000; font-size: 0.9rem; }
  .ck-banner a { text-decoration: underline; }
  .ck-banner__actions { display: flex; gap: 0.5rem; justify-content: flex-end; }
</style>
