---
// Carte d'un avis vérifié, reliée au projet réalisé pour ce client (quand il est publié).
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import type { PublicReview } from '../lib/reviews';
interface Props { review: PublicReview; showProject?: boolean; class?: string }
const { review: r, showProject = true, class: cls = '' } = Astro.props;
const date = (r.publishedAt ?? r.submittedAt ?? r.createdAt).toLocaleDateString('fr-CA', { month: 'long', year: 'numeric' });
---
<figure class:list={['card spot rv', cls]}>
  <div class="rv__top">
    <Stars value={r.rating} />
    <span class="rv__ok"><Icon name="check" /> Avis vérifié</span>
  </div>
  <blockquote>« {r.comment} »</blockquote>
  <figcaption>
    <span class="rv__avatar" aria-hidden="true">{r.author.slice(0, 1).toUpperCase()}</span>
    <span class="rv__who"><strong>{r.author}</strong><small>{[r.business, date].filter(Boolean).join(' · ')}</small></span>
  </figcaption>
  {showProject && r.project && (
    <a class="rv__project" href={`/projets/${r.project.slug}`}>
      {r.project.cover && <img src={r.project.cover.thumbUrl} alt="" width={r.project.cover.width} height={r.project.cover.height} loading="lazy" decoding="async" />}
      <span><small>Projet réalisé</small><strong>{r.project.title}</strong></span>
      <Icon name="arrow-up-right" />
    </a>
  )}
</figure>

<style>
  .rv { display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem; height: 100%; }
  .rv__top { display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .rv__ok { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.74rem; font-weight: 600; color: #86efac; padding: 0.2rem 0.55rem; border-radius: 999px; background: rgb(74 222 128 / 0.1); }
  .rv__ok :global(svg) { width: 12px; height: 12px; }
  .rv blockquote { font-size: 1rem; line-height: 1.55; color: #dcdcea; flex: 1; overflow-wrap: anywhere; }
  .rv figcaption { display: flex; align-items: center; gap: 0.75rem; }
  .rv__avatar { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--blue); font-weight: 700; }
  .rv__who { display: grid; min-width: 0; }
  .rv__who small { color: var(--muted); font-size: 0.82rem; }
  .rv__project { display: flex; align-items: center; gap: 0.8rem; padding: 0.6rem; border-radius: 12px; border: 1px solid var(--line); background: rgb(255 255 255 / 0.02); transition: border-color 0.3s, background 0.3s; }
  .rv__project:hover { border-color: rgb(30 107 255 / 0.5); background: rgb(30 107 255 / 0.08); }
  .rv__project img { width: 72px; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 8px; flex: none; }
  .rv__project span { display: grid; flex: 1; min-width: 0; }
  .rv__project small { font-size: 0.72rem; color: var(--dim); text-transform: uppercase; letter-spacing: 0.08em; }
  .rv__project strong { font-size: 0.92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rv__project > :global(svg) { width: 16px; height: 16px; color: var(--muted); flex: none; }
</style>
