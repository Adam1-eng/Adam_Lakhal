---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { problems } from '../data/site';
---
<section class="section" id="probleme" aria-labelledby="pb-title">
  <div class="wrap">
    <SectionHead eyebrow="Le problème" title="Ce qui vous fait perdre des clients chaque jour." aura="chaque jour." align="center"
      lead="Aujourd’hui, presque tout le monde vérifie un commerce en ligne avant d’appeler ou de se déplacer. Sans bonne vitrine, le client choisit quelqu’un d’autre." />

    <div class="pb__grid">
      {problems.map((p, i) => (
        <article class="card spot lift pb reveal" style={`--i:${i}`}>
          <div class="pb__top">
            <span class="pb__icon"><Icon name={p.kind === 'google' ? 'search' : p.kind === 'facebook' ? 'message' : 'alert'} /></span>
            <span class="pb__num">0{i + 1}</span>
          </div>
          <h3>{p.title}</h3>
          <p>{p.text}</p>

          <div class="pb__ill" aria-hidden="true">
            {p.kind === 'google' && (
              <div class="ill-google">
                <div class="ill-google__bar"><span>coiffeur près de moi</span><Icon name="search" /></div>
                <ol>
                  <li><b>1</b><span class="ln w70"></span></li>
                  <li><b>2</b><span class="ln w55"></span></li>
                  <li><b>3</b><span class="ln w62"></span></li>
                </ol>
                <div class="ill-google__you"><span>Votre commerce</span><em>Page 4</em></div>
              </div>
            )}
            {p.kind === 'facebook' && (
              <div class="ill-chat">
                <p class="b l">C’est combien une coupe ?</p>
                <p class="b l">Vous êtes ouverts dimanche ?</p>
                <p class="b l b--fade">Allô ? 👋</p>
                <span class="ill-chat__badge">12 messages sans réponse</span>
              </div>
            )}
            {p.kind === 'slow' && (
              <div class="ill-slow">
                <div class="ill-slow__url"><Icon name="alert" /> Non sécurisé</div>
                <div class="ill-slow__body"><span class="ln w80"></span><span class="ln w60"></span><span class="ln w70"></span></div>
                <div class="ill-slow__load"><span></span></div>
                <small>Chargement… 8 s</small>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="pb__end reveal">
      <p class="h-m">Chaque jour sans bon site, <span class="aura-text aura-text--red">c’est un client qui appelle votre voisin.</span></p>
      <a href="#solutions" class="btn btn--ghost btn--sm">Voir la solution <Icon name="arrow-down" class="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .pb__grid { display: grid; gap: 1.2rem; }
  @media (min-width: 860px) { .pb__grid { grid-template-columns: repeat(3, 1fr); } }
  .pb { padding: 1.6rem; display: grid; gap: 0.7rem; align-content: start; }
  .pb__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; }
  .pb__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: rgb(248 113 113 / 0.12); border: 1px solid rgb(248 113 113 / 0.3); color: #fca5a5; }
  .pb__icon :global(svg) { width: 20px; height: 20px; }
  .pb__num { font-size: 0.78rem; color: var(--dim); font-variant-numeric: tabular-nums; }
  .pb h3 { font-size: 1.3rem; }
  .pb > p { color: var(--muted); font-size: 0.95rem; }
  .pb__ill { margin-top: 1rem; padding: 1rem; border-radius: 14px; background: rgb(0 0 0 / 0.3); border: 1px solid var(--line); min-height: 170px; font-size: 0.78rem; transition: transform 0.5s var(--ease); }
  .pb:hover .pb__ill { transform: translateY(-4px); }
  .ln { display: block; height: 7px; border-radius: 6px; background: rgb(255 255 255 / 0.1); }
  .w55 { width: 55%; } .w60 { width: 60%; } .w62 { width: 62%; } .w70 { width: 70%; } .w80 { width: 80%; }

  .ill-google__bar { display: flex; justify-content: space-between; align-items: center; padding: 0.45rem 0.8rem; border-radius: 999px; background: rgb(255 255 255 / 0.06); color: var(--muted); margin-bottom: 0.8rem; }
  .ill-google__bar :global(svg) { width: 14px; height: 14px; }
  .ill-google ol { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .ill-google li { display: flex; align-items: center; gap: 0.6rem; }
  .ill-google b { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: rgb(255 255 255 / 0.08); font-size: 0.65rem; color: var(--muted); }
  .ill-google__you { margin-top: 0.8rem; display: flex; justify-content: space-between; padding: 0.45rem 0.7rem; border-radius: 10px; border: 1px dashed rgb(248 113 113 / 0.4); color: var(--dim); }
  .ill-google__you em { font-style: normal; color: #fca5a5; }

  .ill-chat { display: grid; gap: 0.45rem; justify-items: start; position: relative; }
  .ill-chat .b { padding: 0.4rem 0.75rem; border-radius: 14px 14px 14px 4px; background: rgb(255 255 255 / 0.07); color: var(--muted); }
  .ill-chat .b--fade { opacity: 0.5; }
  .ill-chat__badge { margin-top: 0.4rem; padding: 0.3rem 0.65rem; border-radius: 999px; background: rgb(248 113 113 / 0.14); color: #fca5a5; font-weight: 600; }

  .ill-slow__url { display: inline-flex; gap: 0.4rem; align-items: center; padding: 0.3rem 0.7rem; border-radius: 999px; background: rgb(248 113 113 / 0.12); color: #fca5a5; margin-bottom: 0.8rem; }
  .ill-slow__url :global(svg) { width: 13px; height: 13px; }
  .ill-slow__body { display: grid; gap: 0.5rem; margin-bottom: 1rem; filter: blur(0.6px); }
  .ill-slow__load { height: 5px; border-radius: 5px; background: rgb(255 255 255 / 0.08); overflow: hidden; margin-bottom: 0.4rem; }
  .ill-slow__load span { display: block; height: 100%; width: 35%; background: linear-gradient(90deg, #f87171, #fbbf24); animation: load 3s var(--ease) infinite; }
  .ill-slow small { color: var(--dim); }
  @keyframes load { 0% { width: 5%; } 70% { width: 38%; } 100% { width: 40%; } }

  .pb__end { margin-top: clamp(3rem, 6vw, 4.5rem); display: grid; justify-items: center; gap: 1.5rem; text-align: center; }
  .pb__end p { max-width: 24ch; }
</style>
