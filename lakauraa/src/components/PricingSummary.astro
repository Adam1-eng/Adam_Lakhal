---
// Résumé des tarifs (accueil) : mêmes forfaits, mêmes prix et même mention « sur devis » que la page
// Services — tout vient de src/config/site.ts via data/site.ts. Aucun nouveau chiffre.
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { offers } from '../data/site';
import { SITE, madNote } from '../config/site';
---
<section class="section ps" aria-label="Tarifs">
  <div class="wrap">
    <SectionHead idx="04" eyebrow="Tarifs" title="Des prix clairs, sans surprise." align="left"
      lead={`Maquette toujours gratuite. Paiement en deux temps : ${SITE.depositPercent} % au départ, le reste à la mise en ligne.`} />
    <ul class="ps__list">
      {offers.map((o, i) => (
        <li class="card ps__row reveal" style={`--i:${i}`}>
          <span class="ps__name">{o.name}</span>
          <span class="ps__pitch">{o.pitch}</span>
          <span class="ps__price">{o.from ? <><small>{o.from}</small> {o.price} <small>{o.unit}</small></> : <>{o.price} <small>{o.unit}</small></>}{o.mad && <small class="ps__mad">Au Maroc : {o.mad}</small>}</span>
        </li>
      ))}
    </ul>
    <p class="ps__note">{madNote()}</p>
    <div class="ps__more reveal"><a href="/services#forfaits" class="btn btn--ghost">Détail des forfaits <Icon name="arrow" class="arrow" /></a></div>
  </div>
</section>

<style>
  .ps__list { list-style: none; padding: 0; display: grid; gap: 0.7rem; max-width: 900px; margin-inline: auto; }
  .ps__row { display: grid; gap: 0.3rem 1.2rem; align-items: center; padding: 1.1rem 1.3rem; }
  @media (min-width: 760px) { .ps__row { grid-template-columns: 9rem 1fr auto; } }
  .ps__name { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; }
  .ps__pitch { color: var(--muted); font-size: 0.92rem; }
  .ps__price { font-weight: 700; font-size: 1.05rem; white-space: nowrap; }
  .ps__price small { font-weight: 500; color: var(--muted); font-size: 0.8rem; }
  .ps__mad { display: block; margin-top: 0.15rem; }
  .ps__note { text-align: center; margin-top: 1.2rem; color: var(--dim); font-size: 0.88rem; }
  .ps__more { display: flex; justify-content: center; margin-top: 1.2rem; }
</style>
