---
// Lignes topographiques décoratives : un fichier SVG léger (public/topo, généré par scripts/gen-topo.ts), mis en cache.
// Purement décoratif : alt vide, masqué aux lecteurs d'écran, aucun JavaScript.
interface Props { name?: 'aura' | 'terrain'; class?: string; drift?: boolean; opacity?: number }
const { name = 'aura', class: cls = '', drift = true, opacity = 0.34 } = Astro.props;
---
<img class:list={['topo', cls, { 'topo--drift': drift }]} src={`/topo/${name}.svg`} alt="" width="1400" height="900" loading="lazy" decoding="async" aria-hidden="true" style={`--topo-o:${opacity}`} />
<style>
  .topo { display: block; width: 100%; height: 100%; object-fit: cover; opacity: var(--topo-o); pointer-events: none; user-select: none; }
  /* respiration très lente (transformation seulement : aucun recalcul de mise en page) */
  .topo--drift { animation: topoDrift 48s ease-in-out infinite alternate; transform-origin: 50% 50%; }
  @keyframes topoDrift { from { transform: scale(1) translate3d(0, 0, 0); } to { transform: scale(1.07) translate3d(-1.2%, 1%, 0); } }
  @media (prefers-reduced-motion: reduce) { .topo--drift { animation: none; } }
</style>
