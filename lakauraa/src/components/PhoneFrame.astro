---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; class?: string; eager?: boolean }
const { src, alt, class: cls = '', eager = false } = Astro.props;
---
<figure class:list={['phone', cls]}>
  <div class="phone__screen">
    <Image src={src} alt={alt} widths={[240, 400]} sizes="220px" loading={eager ? 'eager' : 'lazy'} />
  </div>
</figure>
