---
import SplitText from './SplitText.astro';
interface Props { eyebrow: string; title: string; aura?: string; lead?: string; crumbs?: { label: string; href?: string }[] }
const { eyebrow, title, aura, lead, crumbs = [] } = Astro.props;
---
<section class="ph" data-aura-zone>
  <div class="ph__bg" aria-hidden="true"><div class="grid-bg"></div><div class="ph__blob"></div></div>
  <div class="wrap ph__inner">
    {crumbs.length > 0 && (
      <nav aria-label="Fil d’Ariane" class="ph__crumbs reveal">
        <ol>
          <li><a href="/">Accueil</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <span class="eyebrow reveal">{eyebrow}</span>
    <SplitText as="h1" class="h-xl" text={title} aura={aura} />
    {lead && <p class="lead reveal" style="--i:3">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .ph { --ax: 70%; --ay: 20%; position: relative; isolation: isolate; overflow: hidden; padding: calc(var(--header-h) + clamp(3.5rem, 9vw, 7rem)) 0 clamp(3rem, 7vw, 5rem); border-bottom: 1px solid var(--line); }
  .ph__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(600px circle at var(--ax) var(--ay), rgb(224 18 47 / 0.1), transparent 60%); }
  .ph__blob { position: absolute; width: 600px; height: 600px; right: -150px; top: -260px; border-radius: 50%; background: radial-gradient(circle, rgb(30 107 255 / 0.5), transparent 65%); filter: blur(70px); }
  .ph__inner { display: grid; gap: 1.4rem; justify-items: start; }
  .ph__inner :global(h1) { max-width: 16ch; }
  .ph__crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.85rem; color: var(--dim); }
  .ph__crumbs li + li::before { content: '/'; margin-right: 0.5rem; opacity: 0.6; }
  .ph__crumbs a:hover { color: var(--text); }
  .ph__crumbs [aria-current] { color: var(--muted); }
</style>
