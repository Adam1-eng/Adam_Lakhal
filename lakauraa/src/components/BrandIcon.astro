---
<svg class:list={['ico', cls]} viewBox="0 0 24 24" aria-hidden="true"
  fill={isFill ? 'currentColor' : 'none'} stroke={isFill ? 'none' : 'currentColor'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
  set:html={isFill ? fill[name] : (stroke[name] ?? '')} />
