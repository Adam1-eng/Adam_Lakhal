---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import SocialLinks from './SocialLinks.astro';
import Signature from './Signature.astro';
import { nav } from '../data/site';
import { telHref, smsHref } from '../lib/content';
const { contact, whatsapp } = Astro.locals.settings;
const hasWa = Boolean((whatsapp.ma + whatsapp.ca).replace(/\D/g, ''));
const waLabel = [whatsapp.ma && 'Maroc', whatsapp.ca && 'Canada'].filter(Boolean).join(' / ');
const year = new Date().getFullYear();
const legal = [
  { label: 'Mentions légales', href: '/mentions-legales' },
  { label: 'Politique de confidentialité', href: '/confidentialite' },
  { label: 'Conditions d’utilisation', href: '/conditions-utilisation' },
  { label: 'Conditions de vente', href: '/conditions-vente' },
  { label: 'Politique cookies', href: '/politique-cookies' },
];
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__cta">
      <p class="ftr__cta-title">Un projet en tête ? <span class="aura-text">Parlons-en.</span></p>
      <div class="ftr__cta-actions">
        <a href="/contact" class="btn btn--primary" data-magnetic>Maquette gratuite <Icon name="arrow" class="arrow" /></a>
        {hasWa && <button type="button" class="btn btn--ghost ftr__wa" data-wa-open><BrandIcon name="whatsapp" /> WhatsApp</button>}
      </div>
    </div>

    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo />
        <p>Sites web rapides, élégants et abordables pour les commerces de Montréal et du Maroc. Conçus et codés à la main par Adam Lakhal.</p>
        <SocialLinks />
      </div>

      <nav class="ftr__col" aria-label="Pied de page">
        <h2>Navigation</h2>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/services#forfaits">Forfaits et prix</a></li>
          <li><a href="/#faq">FAQ</a></li>
        </ul>
      </nav>

      <div class="ftr__col">
        <h2>Contact</h2>
        <ul class="ftr__contact">
          {hasWa && <li><button type="button" data-wa-open><BrandIcon name="whatsapp" /> WhatsApp ({waLabel})</button></li>}
          <li><a href={telHref(contact.phone)}><Icon name="phone" /> {contact.phone}</a></li>
          <li><a href={smsHref(contact.phone)}><Icon name="message" /> Texto au même numéro</a></li>
          <li><a href={`mailto:${contact.email}`}><Icon name="mail" /> {contact.email}</a></li>
          <li><span><Icon name="pin" /> {contact.city} · projets au Maroc à distance</span></li>
        </ul>
      </div>

      <nav class="ftr__col" aria-label="Informations légales">
        <h2>Légal</h2>
        <ul>
          {legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><button type="button" data-cookie-prefs>Préférences cookies</button></li>
        </ul>
      </nav>
    </div>

    <div class="ftr__word" aria-hidden="true">Lakauraa.</div>

    <Signature />

    <div class="ftr__bottom">
      <p>© {year} Lakauraa · Adam Lakhal. Tous droits réservés.</p>
      <p>Réponse en {contact.responseTime}</p>
      <a href="#top" class="ftr__top-link">Haut de page <Icon name="arrow-down" /></a>
    </div>
  </div>
</footer>

<style>
  .ftr { position: relative; padding-top: clamp(3.5rem, 7vw, 5rem); border-top: 1px solid var(--line); background: linear-gradient(180deg, var(--bg-2), var(--bg)); overflow: hidden; }
  .ftr__cta { display: flex; flex-wrap: wrap; gap: 1.4rem 2rem; justify-content: space-between; align-items: center; padding-bottom: clamp(2.5rem, 5vw, 3.5rem); margin-bottom: clamp(2.5rem, 5vw, 3.5rem); border-bottom: 1px solid var(--line); }
  .ftr__cta-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: -0.04em; line-height: 1.05; }
  .ftr__cta-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .ftr__wa :global(svg) { width: 20px; height: 20px; color: #25d366; }
  .ftr__top { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .ftr__top { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .ftr__top { grid-template-columns: 1.4fr 0.8fr 1.3fr 1fr; } }
  .ftr__brand { display: grid; gap: 1.2rem; justify-items: start; align-content: start; }
  .ftr__brand p { color: var(--muted); max-width: 38ch; font-size: 0.95rem; }
  .ftr__col h2 { font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); font-weight: 600; margin-bottom: 1rem; }
  .ftr__col ul { list-style: none; padding: 0; display: grid; gap: 0.65rem; }
  .ftr__col a, .ftr__col span, .ftr__col button { color: var(--muted); font-size: 0.94rem; transition: color 0.2s; display: inline-flex; align-items: center; gap: 0.55rem; text-align: left; }
  .ftr__col button { padding: 0; }
  .ftr__col a:hover, .ftr__col button:hover { color: var(--text); }
  .ftr__contact :global(svg) { width: 16px; height: 16px; flex: none; color: var(--accent); }
  .ftr__contact button :global(svg) { color: #25d366; }
  .ftr__word {
    margin-top: clamp(3rem, 7vw, 5rem);
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(4.5rem, 19vw, 17rem); line-height: 0.8; letter-spacing: -0.06em;
    text-align: center;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    user-select: none;
  }
  .ftr__bottom { display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; justify-content: space-between; align-items: center; padding: 1.5rem 0 calc(2rem + 64px); border-top: 1px solid var(--line); color: var(--dim); font-size: 0.85rem; }
  @media (min-width: 641px) { .ftr__bottom { padding-bottom: 2rem; padding-right: 160px; } }
  .ftr__top-link { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--muted); }
  .ftr__top-link :global(svg) { width: 14px; height: 14px; rotate: 180deg; }
  .ftr__top-link:hover { color: var(--text); }
</style>
