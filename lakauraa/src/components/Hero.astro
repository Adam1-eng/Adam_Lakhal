---
// Accueil · « AURA » : la présence de celui qui est derrière chaque site, rendue visible.
//  - Dégradé thermique : un halo bleu → violet → rouge (les couleurs du logo) autour du portrait.
//  - Verre cannelé : le portrait est vu à travers un verre à cannelures verticales.
//  - Lignes topographiques : le relief de l'énergie, en fond, très lent.
//  - Objet 3D iridescent : l'anneau de la marque (ordinateur seulement ; anneau SVG fixe ailleurs).
import Icon from './Icon.astro';
import HeroTitle from './HeroTitle.astro';
import StarButton from './islands/StarButton';
import AuraRing from './islands/AuraRing';
import Topo from './Topo.astro';
import Stars from './Stars.astro';
import { site } from '../data/site';
import { SITE, entryPrice, money } from '../config/site';
interface Props { rating?: { count: number; average: number; label: string } }
const { rating } = Astro.props;
---
<section class="hero" data-aura-zone aria-labelledby="hero-title">
  <div class="hero__topo" aria-hidden="true"><Topo name="aura" opacity={0.5} /></div>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <HeroTitle id="hero-title" class="hero__title" kicker="Création de site web à Montréal" text="Votre commerce a du caractère. Je le rends visible." />

      <p class="hero__lead reveal" style="--i:4">
        Des sites rapides et élégants, pensés pour le cellulaire.{' '}
        <strong>Vous voyez votre maquette avant de payer.</strong>
      </p>

      <div class="hero__ctas reveal" style="--i:5">
        <StarButton client:media="(min-width: 761px)" href="/contact">
          Obtenir ma maquette gratuite
          <Icon name="arrow" class="arrow" />
        </StarButton>
        <a href="/projets" class="btn btn--ghost" data-magnetic>Voir mes réalisations</a>
      </div>

      {rating && rating.count > 0 && (
        <a href="/avis" class="hero__rating reveal" style="--i:6">
          <Stars value={rating.average} size={16} />
          <span><strong>{rating.label}</strong> / 5 · {rating.count} avis vérifié{rating.count > 1 ? 's' : ''}</span>
        </a>
      )}

      <ul class="hero__checks reveal" style="--i:6">
        <li><Icon name="check" /> Maquette gratuite</li>
        <li><Icon name="check" /> En ligne en {site.delay}</li>
        {entryPrice() != null && <li><Icon name="check" /> Dès {money(entryPrice()!)}</li>}
      </ul>
    </div>

    <figure class="aura reveal" style="--i:3">
      <div class="aura__halo" aria-hidden="true"></div>
      <div class="aura__glass">
        <img class="aura__img" src="/adam-portrait.webp" alt={`${SITE.owner}, fondateur de ${SITE.name}`} width="800" height="880" fetchpriority="high" decoding="async" />
        <img class="aura__img aura__img--refract" src="/adam-portrait.webp" alt="" width="800" height="880" decoding="async" aria-hidden="true" />
        <span class="aura__flutes" aria-hidden="true"></span>
      </div>
      <div class="aura__ring" aria-hidden="true">
        <svg class="aura__ringsvg" viewBox="0 0 64 64"><defs><linearGradient id="ar" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1e6bff" /><stop offset=".55" stop-color="#7b3fd6" /><stop offset="1" stop-color="#e0122f" /></linearGradient></defs><circle cx="30" cy="34" r="20" fill="none" stroke="url(#ar)" stroke-width="6" stroke-dasharray="104 22" stroke-linecap="round" transform="rotate(-50 32 32)" /><circle cx="49" cy="16" r="5" fill="#e0122f" /></svg>
        <AuraRing client:media="(min-width: 761px)" />
      </div>
      <figcaption class="aura__cap"><span>{SITE.owner.toUpperCase()}</span><span>FONDATEUR · {SITE.city.toUpperCase()}</span></figcaption>
    </figure>
  </div>

  <a href="#realisations-apercu" class="hero__scroll" aria-label="Défiler vers la suite"><span></span></a>
</section>

<style>
  .hero {
    --ax: 70%; --ay: 30%;
    position: relative; isolation: isolate;
    padding: calc(var(--header-h) + clamp(2.5rem, 7vw, 5rem)) 0 clamp(3rem, 6vw, 4.5rem);
    min-height: min(100svh, 940px);
    display: flex; align-items: center; overflow: hidden;
  }
  /* relief topographique : visible surtout à droite, fondu vers le fond nuit */
  .hero__topo { position: absolute; inset: 0; z-index: -1; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 72% 45%, #000 8%, transparent 70%); mask-image: radial-gradient(ellipse 70% 80% at 72% 45%, #000 8%, transparent 70%); }

  .hero__grid { display: grid; gap: clamp(2.5rem, 6vw, 4rem); align-items: center; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: 1.08fr 0.92fr; } }
  .hero__copy { display: grid; gap: 1.5rem; justify-items: start; }
  :global(.hero__title) { font-size: clamp(2.6rem, 6.4vw, 4.9rem); max-width: 11.5ch; line-height: 0.98; }
  .hero__lead { font-size: clamp(1.05rem, 1.5vw, 1.2rem); color: var(--muted); max-width: 52ch; }
  .hero__lead strong { color: var(--text); font-weight: 600; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .hero__rating { display: inline-flex; align-items: center; gap: 0.6rem; width: fit-content; padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid var(--line-2); font-size: 0.88rem; color: var(--muted); }
  .hero__rating strong { color: var(--text); }
  .hero__checks { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; font-size: 0.9rem; color: var(--muted); }
  .hero__checks li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .hero__checks :global(svg) { width: 16px; height: 16px; color: var(--accent); }

  /* ---------- Portrait « aura » ---------- */
  .aura { position: relative; width: min(100%, 470px); justify-self: center; margin: 0; --glass: 15px; }
  @media (min-width: 1000px) { .aura { justify-self: end; } }
  /* halo : champ de couleur thermique (bleu → violet → rouge) qui dépasse du cadre */
  .aura__halo { position: absolute; inset: -12% -16% -8% -16%; z-index: -1; border-radius: 50%; background: conic-gradient(from 200deg at 50% 52%, #1e6bff, #7b3fd6, #e0122f, #7b3fd6, #1e6bff); opacity: 0.55; filter: blur(56px); animation: auraBreath 9s ease-in-out infinite alternate; }
  @keyframes auraBreath { from { transform: scale(0.96) rotate(0deg); opacity: 0.45; } to { transform: scale(1.06) rotate(14deg); opacity: 0.62; } }
  @media (max-width: 999px) { .aura { order: -1; width: min(58vw, 250px); } .hero__grid { gap: 1.8rem; } }
  @media (max-width: 760px) { .aura__halo { filter: none; animation: none; inset: -6%; opacity: 0.4; background: radial-gradient(closest-side, #5b3ff0, #1e6bff 55%, transparent 72%); } }

  /* cadre en arche + verre cannelé. L'image est fusionnée en « multiply » : le fond blanc de la photo laisse
     apparaître le halo, la peau prend sa teinte (portrait en duotone thermique), le noir reste noir. */
  .aura__glass { position: relative; isolation: isolate; aspect-ratio: 10 / 11; border-radius: 999px 999px 26px 26px; overflow: hidden; background: conic-gradient(from 215deg at 50% 60%, #1e6bff, #7b3fd6, #e0122f 62%, #7b3fd6, #1e6bff); box-shadow: 0 40px 90px -40px rgb(30 107 255 / 0.65), inset 0 0 0 1px rgb(255 255 255 / 0.1); }
  .aura__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; mix-blend-mode: multiply; filter: brightness(1.22) contrast(1.04); }
  /* cannelures : une seconde copie, décalée et agrandie, visible une bande sur deux = effet de réfraction */
  .aura__img--refract { transform: translateX(-1.6%) scale(1.045); transition: transform 0.9s var(--ease); -webkit-mask-image: repeating-linear-gradient(90deg, #000 0 calc(var(--glass) * 0.5), transparent calc(var(--glass) * 0.5) var(--glass)); mask-image: repeating-linear-gradient(90deg, #000 0 calc(var(--glass) * 0.5), transparent calc(var(--glass) * 0.5) var(--glass)); }
  .aura:hover .aura__img--refract { transform: translateX(1.6%) scale(1.045); }
  /* reflets de verre : fine lumière sur le bord de chaque cannelure */
  .aura__flutes { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.11) 0 2px, rgb(255 255 255 / 0) 2px calc(var(--glass) * 0.5), rgb(0 0 0 / 0.07) calc(var(--glass) * 0.5) var(--glass)); pointer-events: none; -webkit-mask-image: radial-gradient(ellipse 36% 32% at 50% 38%, rgb(0 0 0 / 0.3), #000 100%); mask-image: radial-gradient(ellipse 36% 32% at 50% 38%, rgb(0 0 0 / 0.3), #000 100%); }
  .aura__glass::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(255 255 255 / 0.14), transparent 28%, transparent 70%, rgb(11 11 15 / 0.5)); pointer-events: none; }

  /* anneau iridescent : posé sur l'épaule du cadre */
  .aura__ring { position: absolute; left: -19%; bottom: 7%; width: 50%; aspect-ratio: 1; pointer-events: none; }
  .aura__ringsvg { position: absolute; inset: 14%; width: 72%; height: 72%; transition: opacity 0.6s; filter: drop-shadow(0 12px 30px rgb(30 107 255 / 0.5)); }
  .aura__ring :global(.aura-ring__cv) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .aura__ring:has(canvas[data-ready]) .aura__ringsvg { opacity: 0; }
  @media (max-width: 760px) { .aura__ring { left: -4%; bottom: -6%; width: 38%; } }

  .aura__cap { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.9rem; font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: 0.7rem; letter-spacing: 0.14em; color: var(--dim); }

  .hero__scroll { position: absolute; left: 50%; bottom: 1.4rem; translate: -50% 0; width: 26px; height: 42px; border-radius: 999px; border: 1.5px solid var(--line-2); display: none; justify-content: center; padding-top: 8px; }
  .hero__scroll span { width: 3px; height: 8px; border-radius: 3px; background: var(--muted); animation: wheel 1.8s var(--ease) infinite; }
  @keyframes wheel { 0% { transform: translateY(0); opacity: 1; } 80% { transform: translateY(12px); opacity: 0; } 100% { opacity: 0; } }
  @media (min-width: 1000px) and (min-height: 820px) { .hero__scroll { display: flex; } }
  @media (prefers-reduced-motion: reduce) { .aura__halo { animation: none; } .aura__img--refract { transition: none; } .hero__scroll span { animation: none; } }
</style>
