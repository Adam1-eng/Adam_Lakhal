---
// Chiffres réels uniquement : le nombre de projets vient des projets publiés (jamais écrit en dur),
// les autres valeurs de src/config/site.ts. Valeurs affichées telles quelles (aucun compteur qui part de 0).
import { stats } from '../data/site';
interface Props { projectCount?: number }
const { projectCount } = Astro.props;
const items = [
  ...(projectCount ? [{ value: String(projectCount), label: projectCount > 1 ? 'projets présentés dans les réalisations' : 'projet présenté dans les réalisations' }] : []),
  ...stats,
];
---
<section class="st" aria-label="En chiffres">
  <div class="wrap">
    <dl class="st__grid" style={`--n:${items.length}`}>
      {items.map((s, i) => (
        <div class="st__item reveal" style={`--i:${i}`}>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .st { padding-block: var(--section-y); }
  .st__grid { display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid var(--line); border-radius: var(--radius-l); overflow: hidden; background: linear-gradient(180deg, rgb(255 255 255 / 0.03), transparent); }
  @media (min-width: 900px) { .st__grid { grid-template-columns: repeat(var(--n), 1fr); } }
  .st__item { display: flex; flex-direction: column-reverse; gap: 0.6rem; padding: clamp(1.4rem, 3vw, 2.2rem); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .st__item dd { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.05; letter-spacing: -0.04em; color: var(--text); }
  .st__item dt { font-size: 0.82rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; max-width: 24ch; }
</style>
