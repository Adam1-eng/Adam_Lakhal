---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import CookiePrefs from '../components/CookiePrefs.astro';
import { site } from '../data/site';
import { SITE, entryPrice, money } from '../config/site';
import { activeSocials } from '../lib/content';
import type { Faq as FaqRow } from '../lib/db/schema';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  faqs?: FaqRow[];
  waMessage?: string;
  noindex?: boolean;
  /** Fil d’Ariane pour les données structurées (sans « Accueil », ajouté automatiquement). */
  crumbs?: { name: string; path: string }[];
  /** Données structurées propres à la page (Service, CreativeWork…). */
  schema?: Record<string, unknown>[];
}
const { title, description = site.description, image, imageAlt, faqs = [], waMessage, noindex = false, crumbs = [], schema = [] } = Astro.props;
const settings = Astro.locals.settings;
const canonical = new URL(Astro.url.pathname.replace(/(.)\/+$/, '$1'), Astro.site);
const fullTitle = title.includes('Lakauraa') ? title : `${title} · Lakauraa`;
const ogImage = new URL(image ?? '/og.jpg', Astro.site);
const ogAlt = imageAlt ?? 'Lakauraa · Création de sites web pour commerces, Montréal et Maroc';
const origin = (Astro.site?.href ?? site.url).replace(/\/$/, '');
const id = (k: string) => `${origin}/#${k}`;

// Données structurées : uniquement des informations visibles sur le site (aucun avis, note ni adresse inventés).
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': id('website'), url: `${origin}/`, name: site.name, inLanguage: 'fr-CA', publisher: { '@id': id('business') } },
  {
    '@type': 'ProfessionalService',
    '@id': id('business'),
    name: site.name,
    description: site.description,
    url: `${origin}/`,
    image: `${origin}/og.jpg`,
    logo: `${origin}/icon-512.png`,
    telephone: settings.contact.phone,
    ...(settings.contact.email ? { email: settings.contact.email } : {}),
    sameAs: activeSocials(settings.socials).map((x) => x.url),
    founder: { '@id': id('adam') },
    address: { '@type': 'PostalAddress', addressLocality: 'Montréal', addressRegion: 'QC', addressCountry: 'CA' },
    areaServed: [
      { '@type': 'City', name: 'Montréal' },
      { '@type': 'Country', name: 'Canada' },
      { '@type': 'Country', name: 'Maroc' },
    ],
    ...(entryPrice() != null ? { priceRange: `À partir de ${money(entryPrice()!)}` } : {}),
  },
  { '@type': 'Person', '@id': id('adam'), name: site.owner, jobTitle: 'Développeur web', worksFor: { '@id': id('business') }, url: `${origin}/a-propos`, ...(SITE.ownerPhoto ? { image: `${origin}${SITE.ownerPhoto}` } : {}) },
];
if (crumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Accueil', path: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${origin}${c.path}` })),
  });
}
if (faqs.length) {
  graph.push({ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) });
}
graph.push(...schema);
/** JSON pour <script type="application/ld+json"> : « < » échappé, impossible de fermer la balise. */
const safeJson = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---
<!doctype html>
<html lang="fr-CA" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0b0b0f" />
    {SITE.googleVerification.meta && <meta name="google-site-verification" content={SITE.googleVerification.meta} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={schema.some((x) => x['@type'] === 'CreativeWork') ? 'article' : 'website'} />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:site_name" content="Lakauraa" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" set:html={safeJson({ '@context': 'https://schema.org', '@graph': graph })} />

    <!-- Changement de page instantané : on désactive l'animation native (capture + fondu de 0,4 à 0,5 s
         après chaque clic, ressentie comme du « lag », surtout au cellulaire). Le routeur Astro bascule alors
         sur fallback="swap" : la nouvelle page remplace l'ancienne dès qu'elle est prête, sans animation. -->
    <script is:inline>try { delete Document.prototype.startViewTransition; } catch (e) {}</script>
    <ClientRouter fallback="swap" />
    <script>
      import '../scripts/motion';
      import '../scripts/interactions';
      import '../scripts/track';
      import '../scripts/nav-speed';
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" transition:animate="none">
      <slot />
    </main>
    <Footer />
    <WhatsApp message={waMessage} />
    <CookiePrefs />
    <div class="noise" aria-hidden="true"></div>
  </body>
</html>
