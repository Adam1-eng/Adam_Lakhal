---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ContactForm from '../components/ContactForm.astro';
import Faq from '../components/Faq.astro';
import { process } from '../data/site';
import { getFaqs, telHref, smsHref, activeSocials } from '../lib/content';

const faqs = await getFaqs();
const { contact, whatsapp, socials } = Astro.locals.settings;
const hasWa = Boolean((whatsapp.ma + whatsapp.ca).replace(/\D/g, ''));
const channels = [
  { icon: 'phone', label: 'Appel', value: contact.phone, href: telHref(contact.phone), note: 'Le plus rapide au Canada' },
  { icon: 'message', label: 'Texto', value: contact.phone, href: smsHref(contact.phone), note: 'Même numéro' },
  { icon: 'mail', label: 'Courriel', value: contact.email, href: `mailto:${contact.email}?subject=${encodeURIComponent('Maquette de site web')}`, note: `Réponse en ${contact.responseTime}` },
];
---
<Base faqs={faqs} title="Contact · Obtenir une maquette gratuite" description={`Demandez votre maquette de site web gratuite : WhatsApp, appel ou texto au ${contact.phone}, ou courriel. Réponse en ${contact.responseTime}.`}>
  <PageHero eyebrow="Contact" title="Parlons de votre commerce." aura="votre commerce."
    lead={`Deux minutes pour me décrire votre projet. Je vous prépare une maquette gratuite, sans engagement, et je vous réponds en ${contact.responseTime}.`}
    crumbs={[{ label: 'Contact' }]}>
    {hasWa && (
      <div class="ct__hero-wa reveal" style="--i:4">
        <button type="button" class="btn ct__wa-btn" data-wa-open data-magnetic><BrandIcon name="whatsapp" /> Discuter sur WhatsApp</button>
        <span class="muted">Maroc 🇲🇦 ou Canada 🇨🇦 : le bon numéro vous est proposé automatiquement.</span>
      </div>
    )}
  </PageHero>

  <section class="section ct-s" aria-label="Formulaire et coordonnées">
    <div class="wrap ct">
      <div class="ct__form reveal">
        <h2 class="ct__title">Décrivez votre projet</h2>
        <ContactForm />
      </div>

      <aside class="ct__side">
        <div class="ct__channels">
          {hasWa && (
            <button type="button" class="card spot ct__ch ct__ch--wa reveal" data-wa-open>
              <span class="ct__wa-ico"><BrandIcon name="whatsapp" /></span>
              <span class="ct__ch-txt"><small>WhatsApp · Maroc et Canada</small><strong>Écrire un message</strong></span>
              <Icon name="arrow-up-right" class="ct__ch-go" />
            </button>
          )}
          {channels.map((c, i) => (
            <a href={c.href} class="card spot ct__ch reveal" style={`--i:${i + 1}`}>
              <span class="icon-badge"><Icon name={c.icon} /></span>
              <span class="ct__ch-txt"><small>{c.label} · {c.note}</small><strong>{c.value}</strong></span>
              <Icon name="arrow-up-right" class="ct__ch-go" />
            </a>
          ))}
        </div>

        {activeSocials(socials).length > 0 && (
          <div class="card ct__soc reveal">
            <h2>Suivez mon travail</h2>
            <SocialLinks variant="pills" />
          </div>
        )}

        <div class="card ct__next reveal" style="--i:3">
          <h2>La suite, concrètement</h2>
          <ol>
            {process.map((p, i) => (
              <li><span>{i + 1}</span><div><strong>{p.title}</strong><p>{p.text}</p></div></li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <Faq faqs={faqs} />
</Base>

<style>
  .ct__hero-wa { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.2rem; }
  .ct__wa-btn { background: #25d366; color: #062e16; box-shadow: 0 12px 30px -10px rgb(37 211 102 / 0.6); }
  .ct__wa-btn:hover { background: #2ee374; }
  .ct__wa-btn :global(svg) { width: 22px; height: 22px; }
  .ct__hero-wa .muted { font-size: 0.9rem; }
  .ct-s { padding-top: clamp(3rem, 6vw, 4.5rem); }
  .ct { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 1000px) { .ct { grid-template-columns: 1.4fr 1fr; gap: 2.5rem; } .ct__side { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .ct__title { font-size: 1.4rem; letter-spacing: -0.02em; margin-bottom: 1rem; }
  .ct__side { display: grid; gap: 1.2rem; }
  .ct__channels { display: grid; gap: 0.7rem; }
  .ct__ch { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.2rem; transition: transform 0.4s var(--ease), border-color 0.3s; width: 100%; text-align: left; color: inherit; }
  .ct__ch:hover { transform: translateX(4px); border-color: var(--line-2); }
  .ct__ch--wa { border-color: rgb(37 211 102 / 0.35); background: linear-gradient(90deg, rgb(37 211 102 / 0.1), transparent), var(--surface); }
  .ct__wa-ico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: #25d366; color: #062e16; flex: none; }
  .ct__wa-ico :global(svg) { width: 24px; height: 24px; }
  .ct__ch-txt { display: grid; flex: 1; min-width: 0; }
  .ct__ch-txt small { color: var(--dim); font-size: 0.78rem; }
  .ct__ch-txt strong { font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
  :global(.ct__ch-go) { width: 18px; height: 18px; color: var(--muted); flex: none; }
  .ct__soc, .ct__next { padding: 1.6rem; }
  .ct__soc { display: grid; gap: 1rem; }
  .ct__soc h2, .ct__next h2 { font-size: 1.15rem; letter-spacing: -0.02em; }
  .ct__next h2 { margin-bottom: 1.2rem; }
  .ct__next ol { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .ct__next li { display: flex; gap: 0.9rem; }
  .ct__next li > span { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: rgb(167 139 250 / 0.15); color: #e9d5ff; font-size: 0.8rem; font-weight: 700; }
  .ct__next strong { font-size: 0.95rem; }
  .ct__next p { color: var(--muted); font-size: 0.87rem; }
</style>
