---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { getServices, getFaqs, getPublishedProjects, imageSrcset } from '../lib/content';
import type { ProjectImage } from '../lib/db/schema';

const [services, faqs, projects] = await Promise.all([getServices(), getFaqs(), getPublishedProjects()]);
const bySlug = (s: string) => projects.find((p) => p.slug === s);
const pick = (slug: string, imgIndex = -1) => {
  const p = bySlug(slug);
  if (!p) return null;
  return { project: p, img: p.cover as ProjectImage | null };
};
// Visuel d'illustration par service (projets réels uniquement ; masqué s'ils sont dépubliés)
const visuals: Record<string, { slug: string; note: string } > = {
  vitrine: { slug: 'maquette-bosscut', note: 'Maquette · Barbier' },
  pro: { slug: 'elan-coiffure', note: 'Exemple · forfait Pro' },
  boutique: { slug: 'autorefaatart', note: 'Projet client · AutoRefaatArt' },
  entretien: { slug: 'maquette-plaisirs-gourmets', note: 'Maquette · Traiteur' },
};
const details: Record<string, string[]> = {
  vitrine: ['Design sur mesure à vos couleurs', 'Services, prix, heures et carte', 'Bouton d’appel toujours visible sur cellulaire', 'Liens Facebook, Instagram et itinéraire', '2 séries de révisions incluses'],
  pro: ['Jusqu’à 5 pages (accueil, services, galerie, à propos, contact)', 'Galerie photos et avis clients', 'Lien de réservation en ligne', 'Référencement Google de base', 'Fiche Google Business optimisée'],
  boutique: ['Catalogue, rayons, recherche et filtres', 'Panier et commande adaptée à vos clients (ex. WhatsApp)', 'Espace administrateur : prix, stock, photos', 'Bilingue si nécessaire', 'Soumission gratuite et détaillée'],
  entretien: ['Hébergement et nom de domaine', 'Changements de prix, heures et photos sur simple message', 'Sauvegardes et sécurité', 'Sans contrat, annulable en tout temps'],
};
const icons: Record<string, string> = { vitrine: 'page', pro: 'pages', boutique: 'shop', entretien: 'care' };
const settings = Astro.locals.settings;
---
<Base faqs={faqs} title="Services et prix · Création de sites web à Montréal et au Maroc" description="Site vitrine dès 600 $, site complet 1 200 $, boutique en ligne sur mesure et entretien à 40 $/mois. Maquette gratuite avant de payer.">
  <PageHero eyebrow="Services" title="Un site qui travaille pour vous, même quand vous êtes fermé." aura="même quand vous êtes fermé."
    lead="Du site d’une page à la boutique en ligne, chaque projet est conçu autour d’un seul objectif : que vos clients vous trouvent, vous fassent confiance et vous appellent."
    crumbs={[{ label: 'Services' }]}>
    <div class="reveal" style="--i:4;display:flex;flex-wrap:wrap;gap:.8rem">
      <a href="#forfaits" class="btn btn--primary" data-magnetic>Voir les forfaits <Icon name="arrow-down" class="arrow" /></a>
      <a href="/contact" class="btn btn--ghost" data-magnetic>Demander une maquette</a>
    </div>
  </PageHero>

  <section class="section" aria-label="Détail des services">
    <div class="wrap svd">
      {services.map((s, i) => {
        const v = visuals[s.id] ? pick(visuals[s.id].slug) : null;
        return (
          <article class:list={['svd__row', { 'svd__row--rev': i % 2 === 1 }]} id={s.id}>
            <div class="svd__copy">
              <span class="svd__num reveal">0{i + 1}</span>
              <span class="icon-badge reveal"><Icon name={icons[s.id] ?? 'spark'} /></span>
              <h2 class="h-m reveal">{s.title}</h2>
              <p class="lead reveal" style="--i:1">{s.text}</p>
              {(details[s.id] ?? s.points).length > 0 && <ul class="checks reveal" style="--i:2">{(details[s.id] ?? s.points).map((d) => <li>{d}</li>)}</ul>}
              <div class="svd__foot reveal" style="--i:3">
                <span class="chip chip--accent">{s.price}</span>
                <a href={`/contact?forfait=${s.id === 'vitrine' ? 'essentiel' : s.id}`} class="link-arrow">En parler <Icon name="arrow-up-right" /></a>
              </div>
            </div>
            {v?.img && (
              <a href={`/projets/${v.project.slug}`} class="svd__visual reveal reveal--scale" data-tilt="4">
                <figure class="browser">
                  <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i><span class="browser__url">{v.project.title}</span></div>
                  <img src={v.img.url} srcset={imageSrcset(v.img)} sizes="(min-width: 960px) 600px, 92vw" width={v.img.width} height={v.img.height} alt={`Aperçu : ${v.project.title}`} loading="lazy" decoding="async" />
                </figure>
                <span class="svd__note">{visuals[s.id].note}</span>
              </a>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <Pricing />
  <Process />
  <Faq faqs={faqs} />
  <Cta title="Pas sûr du forfait qui vous convient ?" aura="vous convient ?" text={`Décrivez-moi votre commerce en deux minutes. Je vous conseille honnêtement et je vous réponds en ${settings.contact.responseTime}.`} />
</Base>

<style>
  .svd { display: grid; gap: clamp(5rem, 10vw, 8rem); }
  .svd__row { display: grid; gap: 2.5rem; align-items: center; scroll-margin-top: calc(var(--header-h) + 2rem); }
  @media (min-width: 960px) {
    .svd__row { grid-template-columns: 1fr 1.1fr; gap: 4.5rem; }
    .svd__row--rev .svd__copy { order: 2; }
  }
  .svd__copy { display: grid; gap: 1.1rem; justify-items: start; position: relative; }
  .svd__num { position: absolute; right: 0; top: -1.5rem; font-family: var(--font-display); font-size: clamp(5rem, 10vw, 8rem); font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1px rgb(255 255 255 / 0.08); pointer-events: none; }
  .svd__foot { display: flex; gap: 1.4rem; align-items: center; margin-top: 0.4rem; }
  .svd__visual { position: relative; display: block; transition: transform 0.6s var(--ease); }
  .svd__visual img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .svd__visual::before { content: ''; position: absolute; inset: 10% 5%; z-index: -1; background: radial-gradient(closest-side, rgb(139 92 246 / 0.35), transparent); filter: blur(30px); }
  .svd__note { position: absolute; left: 1rem; bottom: -0.9rem; padding: 0.35rem 0.8rem; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line-2); font-size: 0.78rem; color: var(--muted); }
</style>
