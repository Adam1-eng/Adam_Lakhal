---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import { services, site } from '../data/site';
import { caseStudies, maquettes } from '../data/projets';

const visuals: Record<string, { img: typeof caseStudies[0]['cover']; url: string; alt: string; note: string; href: string }> = {
  vitrine: { img: maquettes.find((m) => m.slug === 'bosscut')!.desktop, url: 'maquette-bosscut.vercel.app', alt: 'Maquette du site BossCut', note: 'Maquette · Barbier', href: '/projets' },
  pro: { img: caseStudies[1].cover, url: 'Élan Coiffure (exemple)', alt: 'Exemple de site Élan Coiffure', note: 'Exemple · forfait Pro', href: '/projets/elan-coiffure' },
  boutique: { img: caseStudies[0].gallery[2].img, url: 'autorefaatart.com', alt: 'Fiche produit de la boutique AutoRefaatArt', note: 'Projet client · AutoRefaatArt', href: '/projets/autorefaatart' },
  entretien: { img: maquettes.find((m) => m.slug === 'plaisirs-gourmets')!.desktop, url: 'maquette-plaisirs-gourmets.vercel.app', alt: 'Maquette du site Plaisirs Gourmets', note: 'Maquette · Traiteur', href: '/projets' },
};
const details: Record<string, string[]> = {
  vitrine: ['Design sur mesure à vos couleurs', 'Services, prix, heures et carte', 'Bouton d’appel toujours visible sur cellulaire', 'Liens Facebook, Instagram et itinéraire', '2 séries de révisions incluses'],
  pro: ['Jusqu’à 5 pages (accueil, services, galerie, à propos, contact)', 'Galerie photos et avis clients', 'Lien de réservation en ligne', 'Référencement Google de base', 'Fiche Google Business optimisée'],
  boutique: ['Catalogue, rayons, recherche et filtres', 'Panier et commande adaptée à vos clients (ex. WhatsApp)', 'Espace administrateur : prix, stock, photos', 'Bilingue si nécessaire', 'Soumission gratuite et détaillée'],
  entretien: ['Hébergement et nom de domaine', 'Changements de prix, heures et photos par texto', 'Sauvegardes et sécurité', 'Sans contrat, annulable en tout temps'],
};
---
<Base title="Services et prix · Création de sites web à Montréal" description="Site vitrine dès 600 $, site complet 1 200 $, boutique en ligne sur mesure et entretien à 40 $/mois. Maquette gratuite avant de payer.">
  <PageHero eyebrow="Services" title="Un site qui travaille pour vous, même quand vous êtes fermé." aura="même quand vous êtes fermé."
    lead="Du site d’une page à la boutique en ligne, chaque projet est conçu autour d’un seul objectif : que vos clients vous trouvent, vous fassent confiance et vous appellent."
    crumbs={[{ label: 'Services' }]}>
    <div class="reveal" style="--i:4;display:flex;flex-wrap:wrap;gap:.8rem">
      <a href="#forfaits" class="btn btn--primary" data-magnetic>Voir les forfaits <Icon name="arrow-down" class="arrow" /></a>
      <a href="/contact" class="btn btn--ghost" data-magnetic>Demander une maquette</a>
    </div>
  </PageHero>

  <section class="section" aria-label="Détail des services">
    <div class="wrap svd">
      {services.map((s, i) => {
        const v = visuals[s.id];
        return (
          <article class:list={['svd__row', { 'svd__row--rev': i % 2 === 1 }]} id={s.id}>
            <div class="svd__copy">
              <span class="svd__num reveal">0{i + 1}</span>
              <span class="icon-badge reveal"><Icon name={s.icon} /></span>
              <h2 class="h-m reveal">{s.title}</h2>
              <p class="lead reveal" style="--i:1">{s.text}</p>
              <ul class="checks reveal" style="--i:2">{details[s.id].map((d) => <li>{d}</li>)}</ul>
              <div class="svd__foot reveal" style="--i:3">
                <span class="chip chip--accent">{s.price}</span>
                <a href={`/contact?forfait=${s.id === 'vitrine' ? 'essentiel' : s.id}`} class="link-arrow">En parler <Icon name="arrow-up-right" /></a>
              </div>
            </div>
            <a href={v.href} class="svd__visual reveal reveal--scale" data-tilt="4">
              <BrowserFrame src={v.img} alt={v.alt} url={v.url} />
              <span class="svd__note">{v.note}</span>
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <Pricing />
  <Process />
  <Faq />
  <Cta title="Pas sûr du forfait qui vous convient ?" aura="vous convient ?" text={`Décrivez-moi votre commerce en deux minutes. Je vous conseille honnêtement et je vous réponds en ${site.responseTime}.`} />
</Base>

<style>
  .svd { display: grid; gap: clamp(5rem, 10vw, 8rem); }
  .svd__row { display: grid; gap: 2.5rem; align-items: center; scroll-margin-top: calc(var(--header-h) + 2rem); }
  @media (min-width: 960px) {
    .svd__row { grid-template-columns: 1fr 1.1fr; gap: 4.5rem; }
    .svd__row--rev .svd__copy { order: 2; }
  }
  .svd__copy { display: grid; gap: 1.1rem; justify-items: start; position: relative; }
  .svd__num { position: absolute; right: 0; top: -1.5rem; font-family: var(--font-display); font-size: clamp(5rem, 10vw, 8rem); font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1px rgb(255 255 255 / 0.08); pointer-events: none; }
  .svd__foot { display: flex; gap: 1.4rem; align-items: center; margin-top: 0.4rem; }
  .svd__visual { position: relative; display: block; transition: transform 0.6s var(--ease); }
  .svd__visual::before { content: ''; position: absolute; inset: 10% 5%; z-index: -1; background: radial-gradient(closest-side, rgb(139 92 246 / 0.35), transparent); filter: blur(30px); }
  .svd__note { position: absolute; left: 1rem; bottom: -0.9rem; padding: 0.35rem 0.8rem; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line-2); font-size: 0.78rem; color: var(--muted); }
</style>
