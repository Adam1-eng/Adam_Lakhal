---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Problems from '../components/Problems.astro';
import Services from '../components/Services.astro';
import Engagements from '../components/Engagements.astro';
import Stats from '../components/Stats.astro';
import Portfolio from '../components/Portfolio.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { getFaqs, getServices, getTestimonials, getPublishedProjects } from '../lib/content';

const [faqs, services, testimonials, featured] = await Promise.all([getFaqs(), getServices(), getTestimonials(), getPublishedProjects({ featured: true })]);
---
<Base title="Lakauraa · Création de sites web pour commerces à Montréal et au Maroc" faqs={faqs}>
  <Hero />
  <Marquee />
  <Problems />
  <Services services={services} />
  <Engagements />
  <Stats />
  <Portfolio projects={featured} limit={6} />
  <Process />
  <Testimonials testimonials={testimonials} />
  <Faq faqs={faqs} />
  <Cta />
</Base>
