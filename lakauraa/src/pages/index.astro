---
// Accueil : accroche, résumé des services, des tarifs et du processus, puis une tuile par sujet.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Showreel from '../components/Showreel.astro';
import AsciiReadout from '../components/AsciiReadout.astro';
import TopicTiles from '../components/TopicTiles.astro';
import Services from '../components/Services.astro';
import PricingSummary from '../components/PricingSummary.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import { getFaqs, getPublishedProjects, getServices } from '../lib/content';
import { getReviewSummary, getPublishedReviews } from '../lib/reviews';
import { entryPrice, money } from '../config/site';

const [faqs, rating, projects, services, reviews] = await Promise.all([getFaqs(), getReviewSummary(), getPublishedProjects(), getServices(), getPublishedReviews()]);
const flagship = projects.find((p) => p.kind === 'client' && p.featured) ?? projects.find((p) => p.kind === 'client') ?? projects[0] ?? null;
---
<Base title="Création de sites web à Montréal et au Maroc · Lakauraa"
  description={`Sites web rapides et élégants pour les commerces de Montréal et du Maroc : salons, restos, garages, spas. ${entryPrice() != null ? `À partir de ${money(entryPrice()!)}, ` : ''}maquette gratuite avant de payer.`}>
  <Hero rating={rating} />
  <Showreel />
  <AsciiReadout />
  <Services services={services} />
  <PricingSummary />
  <Process variant="aura" />
  <Testimonials reviews={reviews} />
  <TopicTiles flagship={flagship} projectCount={projects.length} rating={rating} faqCount={faqs.length} showServices={false} />
</Base>
