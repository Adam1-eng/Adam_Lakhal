---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Problems from '../components/Problems.astro';
import Services from '../components/Services.astro';
import Engagements from '../components/Engagements.astro';
import Stats from '../components/Stats.astro';
import Portfolio from '../components/Portfolio.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { getFaqs, getServices, getPublishedProjects } from '../lib/content';
import { getPublishedReviews, summarize } from '../lib/reviews';

const [faqs, services, reviews, featured] = await Promise.all([getFaqs(), getServices(), getPublishedReviews(), getPublishedProjects({ featured: true })]);
---
<Base title="Lakauraa · Création de sites web pour commerces à Montréal et au Maroc" faqs={faqs}>
  <Hero rating={summarize(reviews)} />
  <Marquee />
  <Problems />
  <Services services={services} />
  <Engagements />
  <Stats />
  <Portfolio projects={featured} limit={6} />
  <Process />
  <Reviews reviews={reviews} />
  <Faq faqs={faqs} />
  <Cta />
</Base>
