---
import LegalPage from '../components/LegalPage.astro';
import { telHref } from '../lib/content';
const { legal, contact } = Astro.locals.settings;
const sections = [
  { id: 'editeur', title: 'Éditeur du site' },
  { id: 'hebergement', title: 'Hébergement' },
  { id: 'propriete', title: 'Propriété intellectuelle' },
  { id: 'maquettes', title: 'Maquettes de démonstration' },
  { id: 'contact', title: 'Contact' },
];
---
<LegalPage title="Mentions légales" description="Mentions légales du site Lakauraa : éditeur, responsable de la publication, hébergeur, contact et propriété intellectuelle." sections={sections}>
  <h2 id="editeur">Éditeur du site</h2>
  <dl>
    <dt>Nom commercial</dt><dd>{legal.businessName || 'Lakauraa'}</dd>
    <dt>Responsable</dt><dd>{legal.ownerName || 'Adam Lakhal'}</dd>
    {legal.legalStatus && <><dt>Statut juridique</dt><dd>{legal.legalStatus}</dd></>}
    {legal.registrationCa && <><dt>Immatriculation (Québec)</dt><dd>{legal.registrationCa}</dd></>}
    {legal.registrationMa && <><dt>Identifiants (Maroc)</dt><dd>{legal.registrationMa}</dd></>}
    {legal.address && <><dt>Adresse</dt><dd>{legal.address}</dd></>}
    <dt>Ville</dt><dd>{contact.city}</dd>
    {contact.email && <><dt>Courriel</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></>}
    <dt>Téléphone</dt><dd><a href={telHref(contact.phone)}>{contact.phone}</a></dd>
    <dt>Directeur de la publication</dt><dd>{legal.ownerName || 'Adam Lakhal'}</dd>
  </dl>

  <h2 id="hebergement">Hébergement</h2>
  <p>Le site est hébergé par <strong>Vercel Inc.</strong>, 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis (vercel.com). Les images du portfolio sont stockées sur le service Vercel Blob et les contenus du site dans une base de données PostgreSQL hébergée par un prestataire infonuagique.</p>

  <h2 id="propriete">Propriété intellectuelle</h2>
  <p>La structure, le design, les textes et le code du site Lakauraa sont la propriété de {legal.ownerName || 'Adam Lakhal'}, sauf mention contraire. Toute reproduction ou réutilisation sans autorisation écrite est interdite.</p>
  <p>Les captures d’écran de projets clients sont publiées avec leur accord ou à partir de sites accessibles publiquement. Les noms et marques des clients appartiennent à leurs titulaires respectifs.</p>

  <h2 id="maquettes">Maquettes de démonstration</h2>
  <p>Certaines réalisations présentées sont des <strong>maquettes de démonstration</strong>, préparées gratuitement pour des commerces avant toute commande. Elles portent la mention « Maquette de démonstration » et ne constituent pas le site officiel de ces entreprises. Les noms, logos et photographies éventuellement utilisés restent la propriété de leurs titulaires. Un commerce qui souhaite le retrait de sa maquette peut l’obtenir sur simple demande, {contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : <>par téléphone ou texto au <a href={telHref(contact.phone)}>{contact.phone}</a></>}.</p>

  <h2 id="contact">Contact</h2>
  <p>Pour toute question concernant le site : {contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : <>par téléphone ou texto au <a href={telHref(contact.phone)}>{contact.phone}</a></>}.</p>
</LegalPage>
