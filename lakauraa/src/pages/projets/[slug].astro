---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import Cta from '../../components/Cta.astro';
import { getProjectBySlug, getPublishedProjects } from '../../lib/content';

const slug = Astro.params.slug ?? '';
const project = await getProjectBySlug(slug);
if (!project) return Astro.rewrite('/404');
const all = await getPublishedProjects();
const idx = all.findIndex((p) => p.id === project.id);
const next = all.length > 1 ? all[(idx + 1) % all.length] : null;
---
<Base title={`${project.title}${project.category ? ' · ' + project.category.name : ''}`} description={project.summary}
  image={project.cover?.url} waMessage={`Bonjour Adam, j’ai vu le projet « ${project.title} » sur votre site. J’aimerais en savoir plus pour mon commerce.`}>
  <ProjectDetail project={project} next={next} />
  <Cta />
</Base>
