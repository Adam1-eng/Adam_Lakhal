---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { eq } from 'drizzle-orm';
import { getDb, schema } from '../../lib/db';
import { verifyPassword, createSession, destroySession, tooManyAttempts, recordAttempt, adminCount, hashPassword, needsRehash, dummyVerify } from '../../lib/auth';
import { str, isSafeNext, clientIp } from '../../lib/admin';
import { securityEvent, maskEmail, maskIp } from '../../lib/security-log';

if (Astro.locals.admin) return Astro.redirect('/admin');
if ((await adminCount()) === 0) return Astro.redirect('/admin/setup');

let error = '';
let email = '';
const next = Astro.url.searchParams.get('next');

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  email = str(fd, 'email').toLowerCase().slice(0, 200);
  const password = String(fd.get('password') ?? '').slice(0, 200);
  const ip = clientIp(Astro.request, Astro.clientAddress ?? 'local');
  const keys = [`ip:${ip}`, `email:${email}`];

  if (await tooManyAttempts(keys)) {
    Astro.response.status = 429;
    securityEvent('login.locked', { email: maskEmail(email), ip: maskIp(ip) });
    error = 'Trop de tentatives. Réessayez dans 15 minutes.';
  } else {
    const db = await getDb();
    const [user] = await db.select().from(schema.admins).where(eq(schema.admins.email, email)).limit(1);
    // Vérification factice si le compte n’existe pas : même temps de réponse (pas d’indice sur les comptes)
    const ok = user ? await verifyPassword(password, user.passwordHash) : await dummyVerify(password);
    if (ok && user) {
      const secure = Astro.url.protocol === 'https:';
      await recordAttempt(keys, true);
      // Mise à niveau transparente du hachage (anciens paramètres scrypt)
      const updates: { lastLoginAt: Date; passwordHash?: string } = { lastLoginAt: new Date() };
      if (needsRehash(user.passwordHash)) updates.passwordHash = await hashPassword(password);
      await db.update(schema.admins).set(updates).where(eq(schema.admins.id, user.id));
      // Anti-fixation : toute session présentée avant la connexion est détruite, une nouvelle est créée
      await destroySession(Astro.cookies, secure);
      await createSession(user.id, Astro.cookies, secure, Astro.request.headers.get('user-agent') ?? '');
      securityEvent('login.success', { admin: user.id, ip: maskIp(ip), rehashed: Boolean(updates.passwordHash) });
      return Astro.redirect(isSafeNext(next) ? next! : '/admin');
    }
    await recordAttempt(keys, false);
    securityEvent('login.failure', { email: maskEmail(email), ip: maskIp(ip), knownAccount: Boolean(user) });
    Astro.response.status = 401;
    error = 'Courriel ou mot de passe incorrect.';
  }
}
---
<AdminLayout title="Connexion" bare>
  <main class="auth">
    <form method="post" class="auth__card adm-form" novalidate>
      <div>
        <p class="eyebrow">Espace privé</p>
      </div>
      <h1>Connexion à l’administration</h1>
      <p>Gérez vos projets, votre FAQ et vos coordonnées.</p>
      {error && <p class="auth__err" role="alert">{error}</p>}
      <div class="field">
        <label for="email">Courriel</label>
        <input class="input" id="email" name="email" type="email" autocomplete="username" required value={email} autofocus />
      </div>
      <div class="field">
        <label for="password">Mot de passe</label>
        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="btn btn--primary" type="submit">Se connecter</button>
      <a href="/" class="muted-s">← Retour au site</a>
    </form>
  </main>
</AdminLayout>
