# Production (Vercel) — à définir dans Vercel → Settings → Environment Variables.
# En local, rien n'est nécessaire : la base PGlite et le stockage local sont utilisés automatiquement.

# Base PostgreSQL (créée automatiquement par l'intégration Neon de Vercel)
DATABASE_URL=

# Stockage des images (créé automatiquement par Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Phrase secrète demandée une seule fois pour créer le premier compte administrateur sur /admin/setup
ADMIN_SETUP_TOKEN=
